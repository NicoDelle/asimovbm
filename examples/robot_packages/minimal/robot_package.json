{
  "name": "minimal-mobile-base",
  "model": {
    "format": "mjcf",
    "path": "robot.xml"
  },
  "sensors": [
    {
      "name": "proprioception",
      "kind": "robot_state",
      "frequency_hz": 40
    },
    {
      "name": "lidar_front",
      "kind": "lidar",
      "frequency_hz": 10
    }
  ],
  "action_mapping": {
    "mode": "mobile_base_velocity",
    "joints": ["linear_velocity", "yaw_rate"]
  },
  "robot_metadata": {
    "forward_axis": "x+",
    "body_class": "mobile_base"
  }
}
